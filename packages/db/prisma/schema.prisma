// Modelo de datos de jobtrail.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

/// Una candidatura a una oferta concreta.
model Application {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  position    String
  url         String?
  source      Source            @default(OTHER)
  status      ApplicationStatus @default(SAVED)
  location    String?
  salaryRange String?
  notes       String?
  appliedAt   DateTime?
  followUpAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  events      StatusEvent[]

  @@index([userId, status])
}

/// Histórico de cambios de fase: permite calcular tasas de respuesta por portal.
model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
}

enum Source {
  LINKEDIN
  INFOJOBS
  INDEED
  COMPANY_SITE
  REFERRAL
  OTHER
}
